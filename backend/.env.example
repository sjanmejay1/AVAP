# =============================================================================
# Automated Vulnerability Assessment Platform (AVAP) — Backend
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in actual values.
# NEVER commit the .env file (or any real secret) to version control.
#
# When running under Docker Compose these variables are injected as container
# environment variables instead — see docker-compose.yml and deployment.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=AVAP
APP_VERSION=1.0.0
# development | staging | production | testing
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# CORS (separately-deployed Next.js frontend)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed browser origins. Add the deployed frontend
# origin(s) in production; never use a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Option 1: Full connection URL (takes precedence if set)
# DATABASE_URL=postgresql://avap_user:changeme@localhost:5432/avap

# Option 2: Individual connection parameters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=avap
POSTGRES_USER=avap_user
POSTGRES_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Scanner Configuration
# -----------------------------------------------------------------------------
# Absolute path to the Nmap binary. Inside the Docker image this is
# /usr/bin/nmap (already set by the image); on Windows hosts it is
# typically C:\Program Files (x86)\Nmap\nmap.exe.
NMAP_EXECUTABLE=/usr/bin/nmap
SCAN_TIMEOUT=900

# -----------------------------------------------------------------------------
# AI Provider Configuration
# -----------------------------------------------------------------------------
# Hugging Face is the only provider. There is no server-wide key: each user
# saves their own token on the Profile page (stored encrypted). The token
# needs the fine-grained "Make calls to Inference Providers" permission, and
# free Hugging Face accounts need purchased credits or PRO to run inference.
AI_PROVIDER=huggingface
# Model id, optionally with a routing suffix such as :cheapest or :fastest.
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=1024
# AI-inferred findings are advisory and excluded from the risk score unless
# this is true.
AI_FINDINGS_IN_RISK=false

# -----------------------------------------------------------------------------
# Reporting
# -----------------------------------------------------------------------------
REPORT_OUTPUT_DIRECTORY=./generated_reports
SCANNER_OUTPUT_DIRECTORY=./scan_output

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIRECTORY=./logs

# -----------------------------------------------------------------------------
# Authentication (required: the backend refuses to start without these)
# -----------------------------------------------------------------------------
# JWT_SECRET_KEY: at least 64 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=
# APP_ENCRYPTION_KEY: Fernet key that encrypts users' saved AI provider keys.
# Losing it makes saved keys unrecoverable (users re-enter them). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
# Optional tuning (defaults shown). REFRESH_COOKIE_SECURE=true is correct for
# local http://localhost too, since browsers treat localhost as secure.
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
# LOGIN_MAX_FAILURES=5
# LOGIN_FAILURE_WINDOW_MINUTES=15
# MIN_CIDR_PREFIX_LENGTH=16
# MAX_CONCURRENT_SCANS=2

# -----------------------------------------------------------------------------
# Raw scan output storage
# -----------------------------------------------------------------------------
# "local" keeps each scan's Nmap XML in STORAGE_LOCAL_DIRECTORY; "s3" uploads
# it to S3_BUCKET as scans/<user>/<scan>/nmap.xml.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIRECTORY=./object_store
S3_BUCKET=
S3_REGION=
# Only for S3-compatible services (leave empty for AWS).
S3_ENDPOINT_URL=
# AES256 (SSE-S3) by default; leave empty if your S3-compatible server rejects it.
S3_SERVER_SIDE_ENCRYPTION=AES256
# Credentials are read by boto3 itself (or use an IAM role). Use a key that
# can only PutObject/GetObject/DeleteObject on this one bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
