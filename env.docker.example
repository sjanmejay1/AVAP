# =============================================================================
# AVAP — Docker Compose configuration template
# =============================================================================
# On Dokploy: paste these into the service's Environment tab.
# Locally: copy to `.env` next to docker-compose.yml. NEVER commit the .env.
#
#   cp env.docker.example .env
#
# Every value here except the secrets below has a working default for a
# single-machine deployment.
# =============================================================================

# --- Required -----------------------------------------------------------------

# Database password (compose refuses to start without it). Use letters and
# digits only: it is embedded unescaped in the database URL, and special
# characters such as @ : / % break the connection or the migrations.
POSTGRES_PASSWORD=change-this-strong-password

# AI: each user adds their own OpenRouter key in the app (Profile page).
# Only free OpenRouter models are ever used.
# Without one, scans, risk scoring and reports still work; AI analysis is
# skipped.

# --- Optional -----------------------------------------------------------------

POSTGRES_DB=avap
POSTGRES_USER=avap_user
ENVIRONMENT=production
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_DATA_COLLECTION=allow
AI_FINDINGS_IN_RISK=false
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=1024
SCAN_TIMEOUT=900
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Authentication (required: the backend refuses to start without these)
# -----------------------------------------------------------------------------
# JWT_SECRET_KEY: at least 64 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=
# APP_ENCRYPTION_KEY: Fernet key that encrypts users' saved AI provider keys.
# Losing it makes saved keys unrecoverable (users re-enter them). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Raw scan output storage
# -----------------------------------------------------------------------------
# "local" keeps each scan's Nmap XML in the avap_storage volume; "s3" uploads
# it to S3_BUCKET as scans/<user>/<scan>/nmap.xml.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
# Only for S3-compatible services (leave empty for AWS).
S3_ENDPOINT_URL=
# AES256 (SSE-S3) by default; leave empty if your S3-compatible server rejects it.
S3_SERVER_SIDE_ENCRYPTION=AES256
# Credentials are read by boto3 itself (or use an IAM role). Use a key that
# can only PutObject/GetObject/DeleteObject on this one bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
