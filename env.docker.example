# =============================================================================
# AVAP — Docker Compose configuration template
# =============================================================================
# Copy this file to `.env` in the repository root (next to docker-compose.yml)
# and edit the values. NEVER commit the resulting .env file.
#
#   cp env.docker.example .env
#
# Every value here except the secrets below has a working default for a
# single-machine deployment.
# =============================================================================

# --- Required -----------------------------------------------------------------

# Database password (required — compose refuses to start without it).
POSTGRES_PASSWORD=change-this-strong-password

# AI: each user adds their own OpenRouter key in the app (Profile page).
# Only free OpenRouter models are ever used.
# Without one, scans, risk scoring and reports still work; AI analysis is
# skipped.

# --- Common overrides ---------------------------------------------------------

# Where the user's BROWSER reaches the backend API. For access from other
# machines, replace localhost with this host's IP or DNS name.
# No trailing slash, no /api/v1 suffix. Changing this requires a rebuild
# (docker compose build frontend) because it is baked into the JS bundle.
FRONTEND_API_BASE_URL=http://localhost:8000

# Browser origin(s) allowed by backend CORS — must match how you open the UI.
# Comma-separated, no wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Published ports on the host (bound to 127.0.0.1 only).
BACKEND_PORT=8000
FRONTEND_PORT=3001

# --- Optional -----------------------------------------------------------------

POSTGRES_DB=avap
POSTGRES_USER=avap_user
ENVIRONMENT=production
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_DATA_COLLECTION=allow
AI_FINDINGS_IN_RISK=false
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=1024
SCAN_TIMEOUT=900
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Public deployment (docker-compose.prod.yml + Caddy). See docs/deployment.md;
# deploy/make-env.sh writes all of these for you on the server.
# -----------------------------------------------------------------------------
# Public hostname Caddy gets an HTTPS certificate for (e.g. avap.duckdns.org).
# AVAP_DOMAIN=
# Shared secret Caddy adds to every API request so the backend believes the
# client IP it reports (login/registration throttles, audit log). At least 32
# random characters. Empty = off (the direct connection address is used).
#   python -c "import secrets; print(secrets.token_hex(32))"
TRUSTED_PROXY_SECRET=
# Targets this deployment may scan: IPv4 addresses, IPv4 CIDRs and hostnames,
# comma-separated. Empty = any target the normal rules accept. Strongly
# recommended for a public URL, e.g. demo-web,demo-cache,scanme.nmap.org
SCAN_TARGET_ALLOWLIST=

# -----------------------------------------------------------------------------
# Authentication (required: the backend refuses to start without these)
# -----------------------------------------------------------------------------
# JWT_SECRET_KEY: at least 64 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=
# APP_ENCRYPTION_KEY: Fernet key that encrypts users' saved AI provider keys.
# Losing it makes saved keys unrecoverable (users re-enter them). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Raw scan output storage
# -----------------------------------------------------------------------------
# "local" keeps each scan's Nmap XML in the avap_storage volume; "s3" uploads
# it to S3_BUCKET as scans/<user>/<scan>/nmap.xml.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
# Only for S3-compatible services (leave empty for AWS).
S3_ENDPOINT_URL=
# AES256 (SSE-S3) by default; leave empty if your S3-compatible server rejects it.
S3_SERVER_SIDE_ENCRYPTION=AES256
# Credentials are read by boto3 itself (or use an IAM role). Use a key that
# can only PutObject/GetObject/DeleteObject on this one bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
